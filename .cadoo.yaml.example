# Example .cadoo.yaml — drop into the root of any repo Cadoo reviews.
# This file is the per-repo override; org-level defaults live in the dashboard.
#
# This is the STRUCTURED half of Cadoo's config (knobs, globs, gates). For
# free-form natural-language review guidance, add a sibling .cadoo.md (see
# .cadoo.md.example) — it is loaded from the same PR head SHA and is additive
# to the conventions / style_guides / path_instructions keys below.

# Which model to use for reviews. Routes through the LLM gateway,
# which can resolve to Anthropic, OpenAI, Gemini, DeepSeek, Ollama, etc.
model: claude-sonnet-4-6

# How aggressively /review surfaces findings:
#   minimal  = production-breaking bugs only
#   balanced = bugs, security, perf, clear maintainability (default)
#   strict   = everything a senior reviewer would object to
#   pedantic = include nits and style notes
strictness: balanced

# Team conventions injected into every review's user message as authoritative.
conventions:
  - "Errors must be wrapped with %w when crossing package boundaries."
  - "All exported Go symbols must have a docstring."
  - "Database migrations are forward-only; never DROP COLUMN."

# Per-language style blurbs surfaced alongside conventions.
style_guides:
  go: "Prefer table-driven tests. Use t.Helper() in test helpers."
  python: "Type hints on every public function. f-strings preferred over .format()."
  typescript: "Strict mode on. No `any` without an inline justification comment."

# Per-tool prompt customization. Override REPLACES the default prompt
# (you take responsibility for completeness); Addendum APPENDS to the
# default (recommended — keeps Cadoo's anti-pattern guards intact).
prompts:
  review:
    addendum: |
      When reviewing changes to internal/auth, treat any change to token
      verification or RBAC checks as security-sensitive even if the diff
      looks small.
  describe:
    addendum: ""

# Comment policy — keeps Cadoo from spamming clean PRs.
comment_policy:
  silent_on_clean: true        # post a passing check-run only, no comment
  skip_if_only_nits: true      # drop the run entirely if every finding is a nit
  min_findings_to_post: 1      # require at least N findings to post anything

# Auto-trigger matrix. Each tool can be set to: never | on_open | on_sync | on_label
auto:
  review: on_open
  describe: on_open
  improve: on_sync
  changelog: never

# Review behaviour
review:
  severity_threshold: warn        # block | warn | nit — anything below is hidden
  include_paths: ["**/*"]
  exclude_paths:
    - "vendor/**"
    - "node_modules/**"
    - "**/*.generated.go"
    - "**/*.pb.go"
  max_comments: 30
  request_changes_on: ["block"]   # severities that mark the PR as Changes Requested

# Path-based instructions (glob → natural-language guidance)
path_instructions:
  - paths: ["**/*.go"]
    instructions: "Prefer table-driven tests. Avoid panics in library code."
  - paths: ["db/migrations/**/*.sql"]
    instructions: "Forward-only migrations. Flag any DROP COLUMN."

# Custom natural-language checks
checks:
  - name: no-fmt-println-in-handlers
    paths: ["internal/api/**/*.go"]
    prompt: "Flag any fmt.Println usage; handlers should use the structured logger."
    severity: warn

# ast-grep structural rules (path glob → rule file)
ast_grep:
  rules: []

# Knowledge base — repos to ingest as cross-references
kb:
  cross_repos: []

# Release-docs subsystem — automated release artifacts generated on tag/release events.
# All artifacts are committed to a docs branch (pages.branch) and/or the VCS release body.
releaseDocs:
  enabled: false          # master switch; set to true to enable release-docs generation
  trigger: release        # "release" (VCS release event) or "tag" (tag push)
  tagPattern: "v*"        # glob matched against tag names; empty = "v*"

  artifacts:
    changelog:
      enabled: true
      when: always         # always | major | minor_or_above | patch_or_above | major | patch

    releaseNotes:
      enabled: true
      when: always
      tone: concise        # concise (default) | detailed | marketing

    blog:
      enabled: true
      when: minor_or_above # blog posts are meaningful for feature/major releases

    # API docs artifact family — fetches a committed OpenAPI/Swagger spec, validates
    # it, and emits three artifacts: the raw spec (openapi.yaml), a self-contained
    # offline Redoc HTML reference (api-reference.html), and a deterministic Markdown
    # reference (api-reference.md). All three outputs are gated by the single
    # enabled + when: condition below (D-07).
    #
    # Failure modes (no spec found, parse error, validation error, unsupported version)
    # are graceful: the generator skips all three artifacts and logs the reason;
    # changelog, release-notes, and blog are unaffected (D-10).
    apiDocs:
      enabled: false
      when: always          # default is "always" — runs on every release (D-08)
      specPath: ""          # repository-relative path to the committed OpenAPI/Swagger spec.
                            # When empty, the generator tries the conventional fallback list (D-02):
                            #   openapi.yaml → openapi.yml → openapi.json →
                            #   docs/openapi.yaml → api/openapi.yaml
                            # Set to a specific path (e.g. "docs/api/openapi.yaml") to skip
                            # fallback discovery and fetch exactly that file at the release tag.

    # Engineering-diagrams artifact family — renders committed Mermaid sources,
    # one markdown page per source (each source wrapped in a ```mermaid fence),
    # published to pages at releases/<tag>/diagrams/<type>/<name>.md. A missing or
    # non-Mermaid source is skipped with a logged reason without failing its
    # siblings or the rest of the run (D-08). All output is gated together by the
    # single enabled + when: condition below (D-07).
    #
    # Pages-rendering nuance: a ```mermaid fence renders natively on github.com's
    # file view and in release bodies, but a Jekyll- or GitLab-Pages *served* site
    # needs a client-side mermaid include to render the fence (deferred).
    diagrams:
      enabled: false
      when: always          # default is "always" — runs on every release (D-08)
      sequence: []          # Mermaid sources using sequenceDiagram
      dependency: []        # Mermaid sources using graph / flowchart / erDiagram
      state: []             # Mermaid sources using stateDiagram
      flowchart: []         # Mermaid sources using flowchart / graph
      class: []             # Mermaid sources using classDiagram

  publish:
    releaseBody:
      enabled: false
    changelogPR:
      enabled: false
    pages:
      enabled: false
      branch: gh-pages      # docs branch to commit release artifacts to
      dir: docs             # base directory within the branch
