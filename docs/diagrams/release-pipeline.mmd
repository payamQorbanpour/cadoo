flowchart TD
    cfg[".cadoo.yaml<br/>(PR head SHA)"] --> dispatcher["releasedocs.Dispatcher"]

    dispatcher --> generators

    subgraph generators["Generators (ordered)"]
        changelog["changelog"]
        releasenotes["release-notes"]
        blog["blog (minor/major)"]
        apidocs["apidocs (MultiGenerator)"]
        diagrams["diagrams (MultiGenerator)"]
    end

    generators --> artifacts["[]releasedocs.Artifact"]

    artifacts --> publishers

    subgraph publishers["Publishers (ordered)"]
        releasebody["releasebody<br/>splice into release body"]
        changelogpr["changelogpr<br/>single CHANGELOG.md PR"]
        pages["pages<br/>docs branch, deterministic path"]
    end

    pages --> pagepath["docs/releases/&lt;tag&gt;/diagrams/&lt;type&gt;/&lt;name&gt;.md<br/>(idempotent UpsertFile)"]
